# Todas as variáveis abaixo são EXCLUSIVAS DO SERVIDOR.
# Nunca use o prefixo NEXT_PUBLIC_ em nenhuma delas: isso as publicaria no
# bundle do navegador. Copie este arquivo para .env.local, que está no
# .gitignore. Nenhum segredo é commitado.

# --- Supabase (migrations prontas; adaptador ainda não implementado) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Motor de vídeo ---
# Mantenha false. O provedor real cobra por frame e sua qualidade ainda NÃO foi
# validada. Com false, ausente, vazio ou qualquer valor diferente da string
# exata "true", a aplicação usa o DemoProvider e não chama endpoint pago algum.
ENABLE_REAL_PROVIDER=false

# Lido somente quando ENABLE_REAL_PROVIDER=true. Sem esta chave, a aplicação
# falha ao subir em vez de cair silenciosamente para a demonstração.
FAL_KEY=
